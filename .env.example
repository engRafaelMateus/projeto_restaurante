# Modelo de configuração. Copie para .env e ajuste.
# O arquivo .env NÃO vai para o Git (veja .gitignore) e não deve conter
# segredo real de produção.

# Gere uma chave para o seu ambiente com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=troque-esta-chave-no-seu-ambiente

# True apenas em desenvolvimento local.
DJANGO_DEBUG=True

# Hosts autorizados, separados por vírgula. Para testar pelo celular na mesma
# rede, acrescente o IP da máquina: 127.0.0.1,localhost,192.168.0.10
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Necessário quando o servidor é acessado por outro endereço (celular na rede).
# Ex.: http://192.168.0.10:8000
DJANGO_CSRF_TRUSTED_ORIGINS=

# Cookies só por HTTPS. Deixe False na demonstração local em http://,
# caso contrário o login não funciona. True em qualquer publicação.
DJANGO_SECURE_COOKIES=False
DJANGO_SECURE_SSL_REDIRECT=False

# Regras de negócio
ATENDIMENTO_QUANTIDADE_MAXIMA_POR_ITEM=99
# 'maior' cobra o sabor mais caro no meio a meio; 'media' usa a média.
ATENDIMENTO_REGRA_MEIO_A_MEIO=maior
